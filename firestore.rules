rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ════════════════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isCoach(coachId) {
      return isAuthenticated() && request.auth.uid == coachId;
    }

    function isCoachAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCoachOfClient(clientId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/coaches/$(request.auth.uid)/clients/$(clientId));
    }

    function canAccessUserTrainingData(userId) {
      return isOwner(userId) || isCoachOfClient(userId) || isCoachAccount();
    }
    
    // ════════════════════════════════════════════════════════════
    // COACHES & CLIENTS (MANTENER)
    // ════════════════════════════════════════════════════════════
    
    match /coaches/{coachId} {
      allow create: if isCoach(coachId);
      allow read, update, delete: if isCoach(coachId);
      
      match /appointments/{appointmentId} {
        allow read, write: if isCoach(coachId);
      }
      
      match /transactions/{transactionId} {
        allow read, write: if isCoach(coachId);
      }
      
      match /clients/{clientId} {
        allow read, write: if isCoach(coachId);
        
        match /anthropometry_records/{recordId} {
          allow read, write: if isCoach(coachId);
        }
        
        match /biochemistry_records/{recordId} {
          allow read, write: if isCoach(coachId);
        }
        
        match /nutrition_records/{recordId} {
          allow read, write: if isCoach(coachId);
        }
        
        match /training_records/{recordId} {
          allow read, write: if isCoach(coachId);
        }
      }
    }
    
    // ════════════════════════════════════════════════════════════
    // ✅ ML TRAINING DATA (SEGURO)
    // ════════════════════════════════════════════════════════════

    match /ml_training_data/{exampleId} {
      // Crear: Solo si el coachId en el documento coincide con el usuario
      allow create: if isAuthenticated() &&
        request.resource.data.coachId == request.auth.uid;
      
      // Leer/Actualizar/Eliminar: Solo si ya es dueño del documento
      allow read, update, delete: if isAuthenticated() &&
        resource.data.coachId == request.auth.uid;
    }

    // ════════════════════════════════════════════════════════════
    // TRAINING V3 USER DATA (MÚSCULO / ANÁLISIS / AUDITORÍA)
    // Permite acceso al propio usuario o al coach dueño del cliente.
    // ════════════════════════════════════════════════════════════

    match /users/{userId} {
      match /muscle_progression/{muscleId} {
        allow read, write: if canAccessUserTrainingData(userId);

        match /progress_history/{weekId} {
          allow read, write: if canAccessUserTrainingData(userId);
        }
      }

      match /weekly_analysis/{analysisId} {
        allow read, write: if canAccessUserTrainingData(userId);
      }

      match /audit_logs/{logId} {
        allow read, write: if canAccessUserTrainingData(userId);
      }

      match /angle_coverage/{coverageId} {
        allow read, write: if canAccessUserTrainingData(userId);
      }
    }

    // ════════════════════════════════════════════════════════════
    // ✅ CLIENT EXERCISE PREFERENCES (NUEVA)
    // Cliente escribe sus preferencias de ejercicio
    // Coach lee preferencias para plan regeneration
    // ════════════════════════════════════════════════════════════
    
    match /clients/{clientId} {
      match /profile {
        match /training {
          // Cliente escribe sus propias preferencias
          allow write: if isOwner(clientId);
          // Coach lee preferencias de su cliente
          allow read: if isOwner(clientId) || isCoachOfClient(clientId);
        }
      }
    }
  }
}
