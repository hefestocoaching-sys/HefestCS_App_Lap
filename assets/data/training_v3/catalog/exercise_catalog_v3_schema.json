{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExerciseCatalogV3",
  "type": "object",
  "required": [
    "version",
    "exercises"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "primaryMuscles",
          "movementPattern",
          "allowedIntensityZones",
          "heavyRole",
          "aEligibility",
          "slotRoles",
          "exerciseOrderClass",
          "rotationGroup"
        ]
      }
    }
  }
}